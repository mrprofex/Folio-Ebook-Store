{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": ["dist/**"]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
